+class TestVirtualImu:
+    """Q1-C/D: virtual IMU datagram sent to pypilot's simulated IMU."""
+
+    @patch("sailsim.autopilot.pypilot.socket.socket")
+    @patch("sailsim.autopilot.pypilot.select.select")
+    def test_imu_datagram_carries_heading_rate_and_roll(
+        self, mock_select, mock_socket_cls, sensors
+    ):
+        """Each compute() sends heading (deg, 0-360), yaw rate (deg/s) and roll (deg) over UDP."""
+        json_sock = _make_mock_socket(b"servo.command=0.0\n")
+        nmea_sock = _make_mock_socket()
+        udp_sock = _make_mock_socket()
+        mock_socket_cls.side_effect = [json_sock, nmea_sock, udp_sock]
+        mock_select.return_value = ([json_sock], [], [])
+
+        ap = PypilotAutopilot(host="test", imu_port=20230)
+        ap.compute(sensors, dt=0.05)
+
+        payload, addr = udp_sock.sendto.call_args[0]
+        data = json.loads(payload.decode())
+        assert addr == ("test", 20230)
+        assert data["heading"] == pytest.approx(180.0)
+        assert data["headingrate"] == pytest.approx(math.degrees(0.02))
+        assert data["roll"] == pytest.approx(5.0)
+
