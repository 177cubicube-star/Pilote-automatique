+    def test_offset_sent_and_settled_before_enable(
+        self, mock_select, mock_socket_cls, mock_sleep, sensors
+    ):
+        """Order on connect: offset, settle wait, then enable."""
+        events: list[str] = []
+        json_sock = _make_mock_socket(b"servo.command=0.0\n")
+        json_sock.sendall.side_effect = lambda b: events.append(b.decode())
+        mock_sleep.side_effect = lambda s: events.append(f"sleep {s}")
+        nmea_sock = _make_mock_socket()
+        udp_sock = _make_mock_socket()
+        mock_socket_cls.side_effect = [json_sock, nmea_sock, udp_sock]
+        mock_select.return_value = ([json_sock], [], [])
+
+        ap = PypilotAutopilot(host="test", imu_port=20230, offset_settle_s=0.5)
+        ap.compute(sensors, dt=0.05)
+
+        i_off = events.index("imu.heading_offset=0\n")
+        i_sleep = events.index("sleep 0.5")
+        i_en = events.index("ap.enabled=true\n")
+        assert i_off < i_sleep < i_en
