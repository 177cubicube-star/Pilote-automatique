diff --git a/src/sailsim/autopilot/pypilot.py b/src/sailsim/autopilot/pypilot.py
index 6094044..45a3679 100644
--- a/src/sailsim/autopilot/pypilot.py
+++ b/src/sailsim/autopilot/pypilot.py
@@ -57,7 +57,19 @@ class PypilotAutopilot:
 
     Each simulation step:
     1. Push sensor data as NMEA sentences (heading, wind, speed)
-    2. Read ``servo.command`` (-1..1) from JSON-TCP and map to rudder angle
+    2. Read ``servo.command`` (-1..1) from JSON-TCP and integrate it as a
+       motor speed demand (actuator model, see ``compute``)
+
+    ``servo.command`` is a normalized motor SPEED demand in pypilot
+    (``servo.py``: ``send_command`` -> ``do_command(speed)``), not a rudder
+    position. The rudder therefore moves at ``-cmd * rudder_rate_max`` and is
+    limited to ``rudder_max``. pypilot's own servo layer (period / windup
+    pulses, calibration) is NOT reproduced here: this is a controller-level
+    SIL, with an ideal velocity actuator.
+
+    Communication safety: once connected, if pypilot stays unreachable for
+    ``comm_timeout`` seconds of simulated time, the speed demand is forced to
+    zero and ``fault`` is latched until ``reset_fault()`` is called.
     """
 
     def __init__(
@@ -70,6 +82,7 @@ class PypilotAutopilot:
         mode: str = "compass",
         timeout: float = 0.5,
         sim_sleep_ms: float = 0.0,
+        comm_timeout: float = 1.0,
     ) -> None:
         self.host = host
         self.json_port = json_port
@@ -79,6 +92,9 @@ class PypilotAutopilot:
         self.mode = mode
         self.timeout = timeout
         self._sim_sleep_s = sim_sleep_ms / 1000.0
+        self.comm_timeout = comm_timeout
+        self.fault = False
+        self._comm_lost_s = 0.0
 
         self._target_heading = 0.0
         self._rudder_angle = 0.0
@@ -109,25 +125,45 @@ class PypilotAutopilot:
             servo_cmd = self._read_servo_command()
             self._last_servo_command = servo_cmd
             self._connected = True
+            self._comm_lost_s = 0.0
         except OSError as exc:
             if not self._connected:
                 raise ConnectionError(
                     f"Cannot reach pypilot at {self.host}:{self.json_port}: {exc}"
                 ) from exc
-            logger.warning(
-                "pypilot unreachable, using last servo command %.3f",
-                self._last_servo_command,
-            )
+            self._comm_lost_s += dt
+            if self._comm_lost_s >= self.comm_timeout and not self.fault:
+                self.fault = True
+                logger.error(
+                    "pypilot unreachable for %.2f s: actuator stopped, fault latched",
+                    self._comm_lost_s,
+                )
+            else:
+                logger.warning(
+                    "pypilot unreachable, using last servo command %.3f",
+                    self._last_servo_command,
+                )
             servo_cmd = self._last_servo_command
             # Reset sockets so _ensure_connected will reconnect next call
             self._close_sockets()
 
-        # Map servo command directly to rudder angle (position mode).
+        if self.fault:
+            servo_cmd = 0.0  # latched safe state: actuator stopped
+
+        # Actuator model: servo.command is a speed demand, integrated over dt.
         # Negate: pypilot positive = port, simulator positive rudder = starboard.
-        self._rudder_angle = -servo_cmd * self.rudder_max
+        servo_cmd = max(-1.0, min(1.0, servo_cmd))
+        rate = -servo_cmd * self.rudder_rate_max
+        new_angle = self._rudder_angle + rate * dt
+        self._rudder_angle = max(-self.rudder_max, min(self.rudder_max, new_angle))
 
         return ControlCommand(rudder_angle=self._rudder_angle, sail_trim=0.5)
 
+    def reset_fault(self) -> None:
+        """Clear a latched communication fault (explicit re-arm)."""
+        self.fault = False
+        self._comm_lost_s = 0.0
+
     # -- connection management --
 
     def _ensure_connected(self) -> None:
