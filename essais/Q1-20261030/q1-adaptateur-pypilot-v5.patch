diff --git a/docker/pypilot/sim_imu_patch.py b/docker/pypilot/sim_imu_patch.py
new file mode 100644
index 0000000..01a2966
--- /dev/null
+++ b/docker/pypilot/sim_imu_patch.py
@@ -0,0 +1,119 @@
+"""Apply the simulated-IMU patch to pypilot's boatimu.py (Q1-C/D).
+
+Replaces pypilot's hardware IMU process with a virtual IMU fed by the
+simulator over UDP (default port 20230). Each datagram is a JSON object:
+
+    {"heading": deg, "headingrate": deg/s, "roll": deg, "pitch": deg}
+
+The virtual IMU turns it into the same data an RTIMULib chip would deliver
+(fusionQPose quaternion, body gyro, accel, timestamp). pypilot's BoatIMU then
+computes heading, headingrate, headingraterate and their low-pass values
+exactly as it does with real hardware, so the `basic` pilot gets real
+D and DD inputs instead of False.
+
+Listening address: environment variable SIM_UDP_BIND, default 127.0.0.1
+(local install). In a container, set it to 0.0.0.0: Docker forwards
+published ports to the container's network address, not to its loopback,
+so a 127.0.0.1 listener would never receive the simulator's datagrams.
+
+If no datagram arrives for 1 s, the virtual IMU reports no data (False), as a
+failed chip would, and pypilot invalidates its IMU values.
+
+The reported heading equals the simulated heading only with
+imu.heading_offset = 0 (pypilot's default is 90 deg, which also turns roll
+into pitch). The SailSim adapter sets it over JSON-TCP when it connects;
+a line in pypilot.conf is NOT enough (checked 2026-10-31, value stayed 90).
+
+Usage: python3 sim_imu_patch.py [path/to/pypilot/boatimu.py]
+Without argument, boatimu.py is searched in site-packages.
+"""
+
+import glob
+import sys
+
+if len(sys.argv) > 1:
+    targets = [sys.argv[1]]
+else:
+    targets = glob.glob("/usr/local/lib/python3.*/site-packages/pypilot/boatimu.py")
+
+if not targets:
+    print("ERROR: Could not find pypilot/boatimu.py", file=sys.stderr)
+    sys.exit(1)
+
+PATCH = """
+
+# --- Simulation patch: virtual IMU fed by the simulator over UDP ---
+SIM_IMU_PORT = 20230
+SIM_IMU_TIMEOUT = 1.0
+
+
+def _sim_q_from_euler(roll, pitch, heading):
+    qz = quaternion.angvec2quat(math.radians(heading), [0, 0, 1])
+    qy = quaternion.angvec2quat(math.radians(pitch), [0, 1, 0])
+    qx = quaternion.angvec2quat(math.radians(roll), [1, 0, 0])
+    return quaternion.multiply(quaternion.multiply(qz, qy), qx)
+
+
+def _sim_setup(self):
+    import json, socket
+    self._sim_json = json
+    self._sim_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+    self._sim_sock.bind((os.environ.get("SIM_UDP_BIND", "127.0.0.1"), SIM_IMU_PORT))
+    self._sim_sock.setblocking(False)
+    self._sim_state = None
+    self._sim_last = 0.0
+    self.rate = 20
+    print("sim imu: listening on udp", self._sim_sock.getsockname())
+
+
+def _sim_read(self):
+    while True:
+        try:
+            pkt, _ = self._sim_sock.recvfrom(4096)
+        except (BlockingIOError, OSError):
+            break
+        try:
+            self._sim_state = self._sim_json.loads(pkt.decode())
+            self._sim_last = time.monotonic()
+        except ValueError:
+            pass
+    t0 = time.monotonic()
+    if self._sim_state is None or t0 - self._sim_last > SIM_IMU_TIMEOUT:
+        return False
+    s = self._sim_state
+    q = _sim_q_from_euler(s.get("roll", 0.0), s.get("pitch", 0.0), s["heading"])
+    gyro = quaternion.rotvecquat([0, 0, math.radians(s.get("headingrate", 0.0))],
+                                 quaternion.conjugate(q))
+    accel = quaternion.rotvecquat([0, 0, 1], quaternion.conjugate(q))
+    return {"fusionQPose": q, "gyro": list(gyro), "accel": list(accel),
+            "compass": [1.0, 0.0, 0.0], "accel.residuals": [0.0, 0.0, 0.0],
+            "timestamp": t0}
+
+
+def _sim_process(self, pipe):
+    print("sim imu process", os.getpid())
+    self.setup()
+    period = 1 / self.rate
+    while True:
+        t0 = time.monotonic()
+        data = self.read()
+        pipe.send(data, not data)
+        try:
+            self.client.receive()
+        except Exception:
+            pass
+        t = period - (time.monotonic() - t0)
+        if 0 < t < period:
+            time.sleep(t)
+
+
+IMU.setup = _sim_setup
+IMU.read = _sim_read
+IMU.process = _sim_process
+IMU.poll = lambda self: None
+"""
+
+for target in targets:
+    with open(target, "a") as f:
+        f.write(PATCH)
+    print(f"Patched {target}")
diff --git a/docker/pypilot/sim_servo_patch.py b/docker/pypilot/sim_servo_patch.py
new file mode 100644
index 0000000..aff4e70
--- /dev/null
+++ b/docker/pypilot/sim_servo_patch.py
@@ -0,0 +1,154 @@
+"""Apply the simulated-motor-controller patch to pypilot's servo.py (Q1-H).
+
+Without a motor controller on a serial port, pypilot's ``Servo.poll()``
+returns at once (``if not self.driver: return``): ``send_command()`` and
+``do_command()`` never run. The pilot's raw output (``servo.command``, an
+unbounded sum of gains) is then the only thing a simulator can read, and
+pypilot's whole servo layer is skipped: gain and inversion, windup
+integration, period between reversals, minimum / maximum speed,
+port / starboard calibration, SATURATED flag, rudder-limit blocking.
+
+This patch installs ``SimServoDriver`` in place of the Arduino motor
+controller, so that layer runs unchanged. The driver reproduces what the
+pypilot motor firmware reports (``arduino/motor/motor.ino``):
+
+- ENGAGED is set when a command is received and cleared on disengage;
+- MIN_RUDDER_FAULT / MAX_RUDDER_FAULT are set when the raw rudder reading
+  leaves the ``minmax`` bounds sent by pypilot in ``params()``
+  (motor.ino lines 1369-1386: raw below min -> MIN, above max -> MAX).
+
+Rudder feedback comes from the simulator over UDP (default port 20231),
+one JSON datagram per step, angle in pypilot's convention (positive = port):
+
+    {"rudder": deg}
+
+It is turned into a raw reading ``deg / SIM_RUDDER_DEG_PER_RAW`` (a sensor
+whose uncalibrated scale equals pypilot's default rudder.scale of 100), so
+pypilot's own rudder calibration (scale, offset, nonlinearity) still
+applies. Listening address: environment variable SIM_UDP_BIND, default
+127.0.0.1; set it to 0.0.0.0 in a container (see sim_imu_patch.py). Without datagrams for 1 s, the rudder reading is reported invalid
+(NaN), as the firmware does with a missing sensor.
+
+NOT reproduced (documented limits): motor-firmware slew rates
+(max_slew_speed / max_slew_slow), current, voltage and temperature
+(no motor model: CURRENT is never reported, so pypilot raises its
+cosmetic DRIVER_TIMEOUT flag while moving), overcurrent faults, clutch.
+
+The motor command actually applied is published by pypilot itself as
+``servo.raw_command`` (-1..1, positive = port), and ``servo.engaged``
+tells whether the driver is engaged: the simulator integrates
+``raw_command`` as a motor speed only when engaged.
+
+Usage: python3 sim_servo_patch.py [path/to/pypilot/servo.py]
+Without argument, servo.py is searched in site-packages.
+"""
+
+import glob
+import sys
+
+if len(sys.argv) > 1:
+    targets = [sys.argv[1]]
+else:
+    targets = glob.glob("/usr/local/lib/python3.*/site-packages/pypilot/servo.py")
+
+if not targets:
+    print("ERROR: Could not find pypilot/servo.py", file=sys.stderr)
+    sys.exit(1)
+
+PATCH = """
+
+# --- Simulation patch: simulated motor controller (Q1-H) ---
+SIM_SERVO_PORT = 20231
+SIM_SERVO_TIMEOUT = 1.0
+SIM_RUDDER_DEG_PER_RAW = 100.0
+
+
+class SimServoDriver:
+    def __init__(self):
+        import json, socket
+        self._json = json
+        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        self._sock.bind((os.environ.get("SIM_UDP_BIND", "127.0.0.1"), SIM_SERVO_PORT))
+        self._sock.setblocking(False)
+        self._last = 0.0
+        self._raw = None
+        self.minmax = (-.5, .5)
+        self.flags = ServoFlags.SYNC
+        self.voltage = self.current = 0
+        self.rudder = float('nan')
+        self.controller_temp = self.motor_temp = 0
+        self.last_command = 0
+        print("sim servo: listening on udp", self._sock.getsockname())
+
+    def poll(self):
+        while True:
+            try:
+                pkt, _ = self._sock.recvfrom(4096)
+            except (BlockingIOError, OSError):
+                break
+            try:
+                deg = float(self._json.loads(pkt.decode())["rudder"])
+            except (ValueError, KeyError, TypeError):
+                continue
+            self._raw = deg / SIM_RUDDER_DEG_PER_RAW
+            self._last = time.monotonic()
+
+        result = ServoTelemetry.FLAGS
+        flags = self.flags & ~(ServoFlags.MIN_RUDDER_FAULT | ServoFlags.MAX_RUDDER_FAULT)
+        if self._raw is None or time.monotonic() - self._last > SIM_SERVO_TIMEOUT:
+            if self._raw is not None:
+                self.rudder = float('nan')
+                result |= ServoTelemetry.RUDDER
+                self._raw = None
+        else:
+            v = self._raw
+            lo, hi = self.minmax
+            pos = lo < hi
+            if (pos and v < lo) or (not pos and v > lo):
+                flags |= ServoFlags.MIN_RUDDER_FAULT
+            if (pos and v > hi) or (not pos and v < hi):
+                flags |= ServoFlags.MAX_RUDDER_FAULT
+            self.rudder = v
+            result |= ServoTelemetry.RUDDER
+        self.flags = flags
+        return result
+
+    def fault(self):
+        return False
+
+    def command(self, command):
+        self.last_command = command
+        self.flags |= ServoFlags.ENGAGED
+
+    def disengage(self):
+        self.last_command = 0
+        self.flags &= ~ServoFlags.ENGAGED
+
+    def params(self, *args):
+        # same order as ArduinoServo.params: max_current, min, max, ...
+        self.minmax = (args[1], args[2])
+
+    def reset(self):
+        pass
+
+
+_sim_servo_orig_init = Servo.__init__
+
+
+def _sim_servo_init(self, client, sensors):
+    import types
+    _sim_servo_orig_init(self, client, sensors)
+    self.driver = SimServoDriver()
+    self.device = types.SimpleNamespace(path='sim', port='sim', baudrate=0)
+    self.controller.set('sim')
+    self.lastpolltime = time.monotonic()
+    self.send_driver_params()
+
+
+Servo.__init__ = _sim_servo_init
+"""
+
+for target in targets:
+    with open(target, "a") as f:
+        f.write(PATCH)
+    print(f"Patched {target}")
